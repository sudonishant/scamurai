# Never bake local secrets, databases or evidence into the image.
# .gitignore excludes these from git, but `COPY . .` would still ship them.
.env
.env.*
*.db
*.sqlite
*.sqlite3
var/
storage/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
tests/
.pytest_cache/
Dockerfile
.dockerignore
