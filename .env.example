# Copy to .env and adjust. No secrets belong in source control or model prompts.
# Everything is prefixed PS03_ and read by app/config.py (pydantic-settings).

# --- storage / runtime -------------------------------------------------------
PS03_ENVIRONMENT=development
# SQLite keeps local dev dependency-free; switch for Docker/Postgres:
PS03_DATABASE_URL=sqlite:///./ps03_dev.db
# PS03_DATABASE_URL=postgresql+psycopg://ps03:password@localhost:5432/ps03
PS03_STORAGE_DIR=./var/storage
PS03_REDIS_URL=
PS03_S3_ENDPOINT=
PS03_S3_BUCKET=ps03-private

# --- prototype guardrails (section 4; adjustable engineering defaults) ------
PS03_MAX_SEED_URLS=5
PS03_MAX_DEPTH=2
PS03_MAX_NEW_ENTITIES=200
PS03_MAX_SOURCE_FETCHES=20
PS03_RUN_DEADLINE_SECONDS=600
PS03_MAX_UPLOAD_BYTES=15728640

# --- image / coordination tuning --------------------------------------------
PS03_PHASH_DISTANCE_THRESHOLD=5
PS03_PIXEL_CORRELATION_THRESHOLD=0.82
PS03_COORDINATION_WINDOW_MINUTES=10
PS03_NEAR_DUPLICATE_RATIO=0.88

# --- external providers (empty = honestly shown as "not configured") --------
PS03_OCR_PROVIDER=
PS03_REVERSE_SEARCH_PROVIDER=
PS03_FACTCHECK_PROVIDER=
PS03_LLM_PROVIDER=
PS03_LLM_MODEL_ID=
PS03_JEV_API_URL=

# --- security / web ----------------------------------------------------------
PS03_JWT_SECRET=change-me-before-deployment
PS03_EXPORT_LINK_TTL_SECONDS=3600
PS03_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
