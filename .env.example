# Copy to .env and adjust. No secrets belong in source control or model prompts.
# All runtime settings use the SCAMURAI_ prefix.

# --- storage / runtime -------------------------------------------------------
SCAMURAI_ENVIRONMENT=development
# SQLite keeps local dev dependency-free; switch for Docker/Postgres:
SCAMURAI_DATABASE_URL=sqlite:///./scamurai_dev.db
# SCAMURAI_DATABASE_URL=postgresql+psycopg://scamurai:password@localhost:5432/scamurai
SCAMURAI_STORAGE_DIR=./var/storage
SCAMURAI_REDIS_URL=
SCAMURAI_S3_ENDPOINT=
SCAMURAI_S3_BUCKET=scamurai-private

# --- prototype guardrails (adjustable engineering defaults) -----------------
SCAMURAI_MAX_SEED_URLS=5
SCAMURAI_MAX_DEPTH=2
SCAMURAI_MAX_NEW_ENTITIES=200
SCAMURAI_MAX_SOURCE_FETCHES=20
SCAMURAI_RUN_DEADLINE_SECONDS=600
SCAMURAI_MAX_UPLOAD_BYTES=15728640

# --- image / coordination tuning --------------------------------------------
SCAMURAI_PHASH_DISTANCE_THRESHOLD=5
SCAMURAI_PIXEL_CORRELATION_THRESHOLD=0.82
SCAMURAI_COORDINATION_WINDOW_MINUTES=10
SCAMURAI_NEAR_DUPLICATE_RATIO=0.88

# --- external providers (empty = honestly shown as "not configured") --------
# Setup and access guide: docs/REQUIRED_CREDENTIALS.md
SCAMURAI_OCR_PROVIDER=
SCAMURAI_REVERSE_SEARCH_PROVIDER=
SCAMURAI_FACTCHECK_PROVIDER=
SCAMURAI_JEV_API_URL=

# LLM — optional; choose ONE route. Local deterministic tools need no LLM key.
# Groq/OpenRouter are OpenAI-compatible; Gemini is native. Use a currently
# provider-supported model ID and verify current pricing/quota/data policies.
SCAMURAI_LLM_PROVIDER=
SCAMURAI_LLM_MODEL_ID=
SCAMURAI_LLM_API_KEY=
SCAMURAI_LLM_BASE_URL=
SCAMURAI_GEMINI_API_KEY=

# Media forensics: deterministic observations run without keys. A model score is
# produced only when a real local Hugging Face image-classification model is set.
# Install optional transformers + torch first; review the model card and local metrics.
SCAMURAI_DEEPFAKE_MODEL_ID=
SCAMURAI_DEEPFAKE_MODEL_REVISION=
SCAMURAI_OSINT_TIMEOUT_SECONDS=12
SCAMURAI_OSINT_MAX_HOSTNAMES=150

# Connectors (optional; server-side keys only; provider access/quota required)
SCAMURAI_YOUTUBE_API_KEY=
SCAMURAI_GOOGLE_FACTCHECK_API_KEY=
# Reddit credentials alone do not establish approved API access.
SCAMURAI_REDDIT_CLIENT_ID=
SCAMURAI_REDDIT_CLIENT_SECRET=
SCAMURAI_REDDIT_USER_AGENT=python:scamurai-investigation:v0.1 (by /u/yourusername)

# --- security / web ----------------------------------------------------------
SCAMURAI_DEV_AUTH_ENABLED=true
SCAMURAI_JWT_SECRET=change-me-before-deployment
SCAMURAI_EXPORT_LINK_TTL_SECONDS=3600
SCAMURAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
